API_HOST=0.0.0.0
API_PORT=8000
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=20
WORKER_JOB_TIMEOUT_SECONDS=1800

QUEUE_MODE=redis
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=enya-jobs

STUB_SINGLE_DELAY_SECONDS=2.0
STUB_MULTI_DELAY_SECONDS=4.0

SF3D_MODE=stub
SF3D_HTTP_URL=http://localhost:9001/generate
SF3D_HTTP_TIMEOUT_SECONDS=300
SF3D_SUBPROCESS_COMMAND_JSON=["python","scripts/run_sf3d_bridge.py"]
SF3D_REPO_PATH=third_party/stable-fast-3d
SF3D_PYTHON_BIN=python
SF3D_PRETRAINED_MODEL=stabilityai/stable-fast-3d
SF3D_DEVICE=cuda
SF3D_TEXTURE_RESOLUTION=1024
SF3D_REMESH_OPTION=none
SF3D_TARGET_VERTEX_COUNT=-1

HUNYUAN_MV_MODE=stub
HUNYUAN_MV_HTTP_URL=http://localhost:9002/generate
HUNYUAN_MV_HTTP_TIMEOUT_SECONDS=600
HUNYUAN_MV_SUBPROCESS_COMMAND_JSON=["python","scripts/run_hunyuan_mv_bridge.py"]
HUNYUAN_MV_REPO_PATH=third_party/Hunyuan3D-2-official
HUNYUAN_MV_MODEL_PATH=tencent/Hunyuan3D-2mv
HUNYUAN_MV_SHAPE_SUBFOLDER=hunyuan3d-dit-v2-mv
HUNYUAN_MV_DEVICE=cuda
HUNYUAN_MV_REMOVE_BACKGROUND=1
HUNYUAN_MV_ENABLE_FLASHVDM=0
HUNYUAN_MV_ENABLE_TEXTURE=1
HUNYUAN_MV_LOW_VRAM_MODE=1
HUNYUAN_MV_NUM_STEPS=50
HUNYUAN_MV_GUIDANCE_SCALE=5.0
HUNYUAN_MV_OCTREE_RESOLUTION=380
HUNYUAN_MV_NUM_CHUNKS=20000
HUNYUAN_MV_SEED=12345
HUNYUAN_MV_CANVAS_SIZE=1024
HUNYUAN_MV_SUBJECT_FILL=0.78
HUNYUAN_MV_BOTTOM_MARGIN_RATIO=0.05
HUNYUAN_MV_TAUBIN_SMOOTHING_ITERATIONS=12
HUNYUAN_MV_TEXTURE_MAX_BODY_REFS=8
HUNYUAN_MV_TEXTURE_INCLUDE_FACE_REFS=0
HUNYUAN_MV_TEXTURE_MAX_FACE_REFS=0
HUNYUAN_MV_TEXTURE_STRATEGY=auto
HUNYUAN_MV_ENABLE_RIG=0
HUNYUAN_MV_RIG_STRICT=0
BLENDER_BIN=C:/Program Files/Blender Foundation/Blender 5.1/blender.exe
HUNYUAN_TEX_MODEL_PATH=tencent/Hunyuan3D-2
HUNYUAN_TEX_SUBFOLDER=hunyuan3d-paint-v2-0
