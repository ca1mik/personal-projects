# Optional for local demo mode:
# you can skip creating `.env` entirely and run `docker compose up -d`.
# The project already has built-in local defaults for mock LLM, mock MAX,
# mock YooKassa and demo admin access.
# Use this file when you want to override defaults or enable real integrations.
#
# APP_NAME
# Что делает: имя приложения для логов и OpenAPI.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: Support Bot
APP_NAME=Support Bot

# APP_ENV
# Что делает: переключает режим среды (`local`, `staging`, `production`, `test`).
# Обязательна ли: да.
# Где взять: задается вручную.
# Пример: production
APP_ENV=local

# DEBUG
# Что делает: включает debug-режим приложения.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: false
DEBUG=false

# LOG_LEVEL
# Что делает: задает уровень логирования.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: INFO
LOG_LEVEL=INFO

# LOG_JSON
# Что делает: включает structured JSON-логи.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: true
LOG_JSON=true

# TIMEZONE
# Что делает: задает таймзону приложения и Celery Beat.
# Обязательна ли: да.
# Где взять: задается вручную.
# Пример: Europe/Moscow
TIMEZONE=Europe/Moscow

# WEBHOOK_BASE_URL
# Что делает: базовый публичный HTTPS URL для webhook и legal pages.
# Обязательна ли: да для production.
# Где взять: ваш домен или reverse proxy.
# Пример: https://bot.example.com
WEBHOOK_BASE_URL=

# TELEGRAM_BOT_TOKEN
# Что делает: позволяет приложению принимать и отправлять сообщения в Telegram.
# Обязательна ли: да для Telegram.
# Где взять: @BotFather.
# Пример: 123456789:AAExampleToken
TELEGRAM_BOT_TOKEN=

# TELEGRAM_WEBHOOK_URL
# Что делает: переопределяет URL webhook Telegram; если пусто, используется WEBHOOK_BASE_URL + /webhooks/telegram.
# Обязательна ли: нет.
# Где взять: ваш публичный HTTPS URL.
# Пример: https://bot.example.com/webhooks/telegram
TELEGRAM_WEBHOOK_URL=

# TELEGRAM_PAYMENT_PROVIDER_TOKEN
# Что делает: включает Telegram Payments fallback через sendInvoice.
# Обязательна ли: нет, только для Telegram payment fallback.
# Где взять: BotFather Payments / подключенный провайдер Telegram.
# Пример: 381764678:TEST:12345
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# MAX_API_TOKEN
# Что делает: токен доступа к MAX API.
# Обязательна ли: да для боевого MAX, нет для mock/dev режима.
# Где взять: кабинет разработчика MAX.
# Пример: Bearer eyJhbGciOi...
MAX_API_TOKEN=

# MAX_WEBHOOK_SECRET
# Что делает: защищает входящий MAX webhook дополнительным секретом.
# Обязательна ли: рекомендуется.
# Где взять: задается вручную и указывается в настройках MAX webhook.
# Пример: max-webhook-secret-2026
MAX_WEBHOOK_SECRET=

# MAX_API_BASE_URL
# Что делает: базовый URL MAX API.
# Обязательна ли: нет.
# Где взять: docs MAX, обычно менять не нужно.
# Пример: https://platform-api.max.ru
MAX_API_BASE_URL=https://platform-api.max.ru

# MAX_MOCK_MODE
# Что делает: включает mock/dev режим MAX без реальной доставки сообщений.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: true
MAX_MOCK_MODE=true

# YOOKASSA_SHOP_ID
# Что делает: идентифицирует магазин ЮKassa.
# Обязательна ли: да для оплат через ЮKassa.
# Где взять: кабинет ЮKassa -> настройки магазина.
# Пример: 123456
YOOKASSA_SHOP_ID=

# YOOKASSA_SECRET_KEY
# Что делает: используется для API-вызовов ЮKassa.
# Обязательна ли: да для оплат через ЮKassa.
# Где взять: кабинет ЮKassa -> Интеграция -> API-ключи.
# Пример: live_xxxxxxxxxxxxxxxxxxxxx
YOOKASSA_SECRET_KEY=

# YOOKASSA_RETURN_URL
# Что делает: URL возврата пользователя после оплаты.
# Обязательна ли: да для оплат через ЮKassa.
# Где взять: ваш публичный HTTPS URL.
# Пример: https://bot.example.com/payment-return
YOOKASSA_RETURN_URL=https://bot.example.com/payment-return

# YOOKASSA_WEBHOOK_SECRET
# Что делает: опционально защищает webhook ЮKassa через query-параметр `secret`.
# Обязательна ли: рекомендуется.
# Где взять: задается вручную.
# Пример: yookassa-webhook-secret-2026
YOOKASSA_WEBHOOK_SECRET=

# YOOKASSA_ENABLE_RECEIPTS
# Что делает: включает формирование receipt для 54-ФЗ.
# Обязательна ли: рекомендуется для production.
# Где взять: задается вручную.
# Пример: true
YOOKASSA_ENABLE_RECEIPTS=false

# YOOKASSA_RECEIPT_DEFAULT_EMAIL
# Что делает: email по умолчанию для электронного чека, если пользовательский email не собран.
# Обязательна ли: нет.
# Где взять: сервисный email магазина.
# Пример: receipts@example.com
YOOKASSA_RECEIPT_DEFAULT_EMAIL=

# YOOKASSA_RECEIPT_VAT_CODE
# Что делает: VAT-код позиции в receipt.
# Обязательна ли: нет.
# Где взять: бухгалтер / настройки ЮKassa.
# Пример: 1
YOOKASSA_RECEIPT_VAT_CODE=1

# YOOKASSA_RECEIPT_TAX_SYSTEM_CODE
# Что делает: налоговый режим чека для 54-ФЗ.
# Обязательна ли: нет.
# Где взять: бухгалтер / настройки онлайн-кассы.
# Пример: 1
YOOKASSA_RECEIPT_TAX_SYSTEM_CODE=

# LLM_PROVIDER
# Что делает: выбирает LLM provider (`openai`, `anthropic`, `yandexgpt`, `gigachat`, `mock`).
# Обязательна ли: да.
# Где взять: задается вручную.
# Пример: openai
LLM_PROVIDER=mock

# LLM_MODEL
# Что делает: имя модели выбранного провайдера.
# Обязательна ли: да для реальных LLM.
# Где взять: документация выбранного провайдера.
# Пример: gpt-5.4-mini
LLM_MODEL=gpt-5.4-mini

# LLM_API_KEY
# Что делает: общий fallback API key, если не заполнен provider-specific key.
# Обязательна ли: нет.
# Где взять: личный кабинет провайдера.
# Пример: sk-fallback-example
LLM_API_KEY=

# OPENAI_API_KEY
# Что делает: ключ OpenAI provider.
# Обязательна ли: да для `LLM_PROVIDER=openai`.
# Где взять: OpenAI dashboard.
# Пример: sk-openai-example
OPENAI_API_KEY=

# ANTHROPIC_API_KEY
# Что делает: ключ Anthropic provider.
# Обязательна ли: да для `LLM_PROVIDER=anthropic`.
# Где взять: Anthropic Console.
# Пример: sk-ant-example
ANTHROPIC_API_KEY=

# YANDEXGPT_API_KEY
# Что делает: ключ доступа к YandexGPT API.
# Обязательна ли: да для `LLM_PROVIDER=yandexgpt`.
# Где взять: Yandex Cloud.
# Пример: y0_AgAAAABexample
YANDEXGPT_API_KEY=

# YANDEXGPT_FOLDER_ID
# Что делает: folder id для запросов в YandexGPT.
# Обязательна ли: да для `LLM_PROVIDER=yandexgpt`.
# Где взять: Yandex Cloud Console.
# Пример: b1gxxxxxxxxxxxxxxx
YANDEXGPT_FOLDER_ID=

# YANDEXGPT_API_URL
# Что делает: позволяет переопределить URL YandexGPT API.
# Обязательна ли: нет.
# Где взять: docs YandexGPT.
# Пример: https://llm.api.cloud.yandex.net/foundationModels/v1/completion
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# YANDEXGPT_AUTH_SCHEME
# Что делает: схема авторизации YandexGPT (`Bearer` или `Api-Key`).
# Обязательна ли: нет.
# Где взять: docs YandexGPT.
# Пример: Bearer
YANDEXGPT_AUTH_SCHEME=Bearer

# GIGACHAT_CLIENT_ID
# Что делает: client id для получения OAuth token GigaChat.
# Обязательна ли: да для `LLM_PROVIDER=gigachat`.
# Где взять: кабинет GigaChat / Сбер API.
# Пример: gigachat-client-id
GIGACHAT_CLIENT_ID=

# GIGACHAT_CLIENT_SECRET
# Что делает: client secret для получения OAuth token GigaChat.
# Обязательна ли: да для `LLM_PROVIDER=gigachat`.
# Где взять: кабинет GigaChat / Сбер API.
# Пример: gigachat-client-secret
GIGACHAT_CLIENT_SECRET=

# GIGACHAT_AUTH_URL
# Что делает: позволяет переопределить OAuth endpoint GigaChat.
# Обязательна ли: нет.
# Где взять: docs GigaChat.
# Пример: https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# GIGACHAT_API_URL
# Что делает: позволяет переопределить chat completion endpoint GigaChat.
# Обязательна ли: нет.
# Где взять: docs GigaChat.
# Пример: https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# GIGACHAT_SCOPE
# Что делает: задает scope для OAuth запроса GigaChat.
# Обязательна ли: нет.
# Где взять: docs GigaChat.
# Пример: GIGACHAT_API_B2B
GIGACHAT_SCOPE=GIGACHAT_API_B2B

# DATABASE_URL
# Что делает: строка подключения FastAPI/Alembic/Celery к PostgreSQL.
# Обязательна ли: да.
# Где взять: формируется вручную из параметров PostgreSQL.
# Пример: postgresql+asyncpg://support_bot:support_bot@postgres:5432/support_bot
DATABASE_URL=postgresql+asyncpg://support_bot:support_bot@postgres:5432/support_bot

# REDIS_URL
# Что делает: broker/result backend для Celery и runtime Redis.
# Обязательна ли: да.
# Где взять: формируется вручную для вашего Redis.
# Пример: redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

# ADMIN_USER_IDS
# Что делает: список Telegram user_id администраторов для уведомлений.
# Обязательна ли: рекомендуется.
# Где взять: user_id администраторов Telegram.
# Пример: 123456789,987654321
ADMIN_USER_IDS=

# ADMIN_API_SECRET
# Что делает: включает и защищает admin endpoint.
# Обязательна ли: нет, но рекомендуется для production.
# Где взять: задается вручную.
# Пример: super-secret-admin-token
ADMIN_API_SECRET=demo-admin-secret

# SUPPORT_CONTACT
# Что делает: контакт поддержки, который бот показывает пользователю.
# Обязательна ли: да.
# Где взять: Telegram username, email или иной канал поддержки.
# Пример: @support_team
SUPPORT_CONTACT=@support_team

# CHECKIN_ENABLED
# Что делает: глобально включает/выключает ежедневные check-in задачи.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: true
CHECKIN_ENABLED=true

# CHECKIN_DEFAULT_TIME
# Что делает: час отправки check-in по умолчанию для новых пользователей, если они не выбрали свой.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 7
CHECKIN_DEFAULT_TIME=7

# DAILY_CHECKIN_MESSAGE
# Что делает: шаблон текста ежедневного check-in.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: Привет. Как ты сегодня? Что чувствуешь?
DAILY_CHECKIN_MESSAGE=Привет. Как ты сегодня? Что чувствуешь?

# PREVIEW_USER_MESSAGES
# Что делает: лимит бесплатных ответов бота до paywall.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 3
PREVIEW_USER_MESSAGES=3

# ROLLING_WINDOW_MESSAGES
# Что делает: число последних сообщений, передаваемых в LLM как active context.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 8
ROLLING_WINDOW_MESSAGES=8

# SUMMARY_THRESHOLD_MESSAGES
# Что делает: частота пересборки session summary.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 12
SUMMARY_THRESHOLD_MESSAGES=12

# LEGAL_DOC_VERSION
# Что делает: общая версия legal-документов, если не заданы отдельные версии.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 2026-06-10
LEGAL_DOC_VERSION=2026-06-10

# PRIVACY_POLICY_VERSION
# Что делает: версия privacy policy, сохраняемая в consents.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: privacy-2026-06-10
PRIVACY_POLICY_VERSION=privacy-2026-06-10

# OFFER_VERSION
# Что делает: версия оферты, сохраняемая в consents.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: offer-2026-06-10
OFFER_VERSION=offer-2026-06-10

# DISCLAIMER_VERSION
# Что делает: версия дисклеймера, сохраняемая в consents.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: disclaimer-2026-06-10
DISCLAIMER_VERSION=disclaimer-2026-06-10

# PLAN_WEEK_TITLE
# Что делает: название недельного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: Неделя поддержки
PLAN_WEEK_TITLE=Неделя поддержки

# PLAN_WEEK_PRICE_RUB
# Что делает: цена недельного тарифа в рублях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 390
PLAN_WEEK_PRICE_RUB=390

# PLAN_WEEK_DAYS
# Что делает: длительность недельного тарифа в днях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 7
PLAN_WEEK_DAYS=7

# PLAN_WEEK_AUTO_RENEW
# Что делает: включает/выключает автопродление недельного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: false
PLAN_WEEK_AUTO_RENEW=false

# PLAN_WEEK_DESCRIPTION
# Что делает: краткое описание недельного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 7 дней поддержки без автопродления
PLAN_WEEK_DESCRIPTION=7 дней поддержки без автопродления

# PLAN_MONTH_TITLE
# Что делает: название месячного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: Месяц рядом
PLAN_MONTH_TITLE=Месяц рядом

# PLAN_MONTH_PRICE_RUB
# Что делает: цена месячного тарифа в рублях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 990
PLAN_MONTH_PRICE_RUB=990

# PLAN_MONTH_DAYS
# Что делает: длительность месячного тарифа в днях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 30
PLAN_MONTH_DAYS=30

# PLAN_MONTH_AUTO_RENEW
# Что делает: включает/выключает автопродление месячного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: true
PLAN_MONTH_AUTO_RENEW=true

# PLAN_MONTH_DESCRIPTION
# Что делает: краткое описание месячного тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 30 дней поддержки с автопродлением
PLAN_MONTH_DESCRIPTION=30 дней поддержки с автопродлением

# PLAN_QUARTER_TITLE
# Что делает: название квартального тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: Квартал заботы
PLAN_QUARTER_TITLE=Квартал заботы

# PLAN_QUARTER_PRICE_RUB
# Что делает: цена квартального тарифа в рублях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 2490
PLAN_QUARTER_PRICE_RUB=2490

# PLAN_QUARTER_DAYS
# Что делает: длительность квартального тарифа в днях.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 90
PLAN_QUARTER_DAYS=90

# PLAN_QUARTER_AUTO_RENEW
# Что делает: включает/выключает автопродление квартального тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: true
PLAN_QUARTER_AUTO_RENEW=true

# PLAN_QUARTER_DESCRIPTION
# Что делает: краткое описание квартального тарифа.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 90 дней поддержки с автопродлением и скидкой
PLAN_QUARTER_DESCRIPTION=90 дней поддержки с автопродлением и скидкой

# POSTGRES_DB
# Что делает: имя БД для контейнера PostgreSQL в docker compose.
# Обязательна ли: да при использовании compose-файла из проекта.
# Где взять: задается вручную.
# Пример: support_bot
POSTGRES_DB=support_bot

# POSTGRES_USER
# Что делает: пользователь PostgreSQL для docker compose.
# Обязательна ли: да при использовании compose-файла из проекта.
# Где взять: задается вручную.
# Пример: support_bot
POSTGRES_USER=support_bot

# POSTGRES_PASSWORD
# Что делает: пароль PostgreSQL для docker compose.
# Обязательна ли: да при использовании compose-файла из проекта.
# Где взять: задается вручную.
# Пример: support_bot
POSTGRES_PASSWORD=support_bot

# APP_PORT
# Что делает: внешний порт FastAPI-сервиса в docker compose.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 8000
APP_PORT=8000

# POSTGRES_PORT
# Что делает: внешний порт PostgreSQL в docker compose.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 5432
POSTGRES_PORT=5432

# REDIS_PORT
# Что делает: внешний порт Redis в docker compose.
# Обязательна ли: нет.
# Где взять: задается вручную.
# Пример: 6379
REDIS_PORT=6379
